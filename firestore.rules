rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMod() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'moderator';
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'user';
      // Users can update their own stats but never their role.
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 140
                    && request.resource.data.body.size() <= 10000;
      // Any signed-in user may only bump the comment counter.
      allow update: if signedIn()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount']);
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isMod());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 3000;
        allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isMod());
      }
    }
  }
}
